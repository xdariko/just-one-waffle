  - {fileID: 11400000, guid: 8c5b7bad478ae684fa09e0b7d5c4c816, type: 2}
  happyLines:
  - "\u041C\u043C\u043C, \u0442\u043E \u0447\u0442\u043E \u043D\u0430\u0434\u043E!
    \u0421\u043F\u0430\u0441\u0438\u0431\u043E!"
  neutralLines:
  - "\u041D\u0443... \u0435\u0441\u0442\u044C \u043C\u043E\u0436\u043D\u043E."
  unhappyLines:
  - "\u042D\u0442\u043E \u043D\u0435 \u0442\u043E, \u0447\u0442\u043E \u044F \u043F\u0440\u043E\u0441\u0438\u043B."
  defectRemarks:
  - defect: "\u0441\u043A\u043E\u0440\u043B\u0443\u043F\u0430 \u0432 \u0442\u0435\u0441\u0442\u0435"
    lines:
    - "\u041E\u0439, \u043D\u0430 \u0437\u0443\u0431\u0430\u0445 \u0447\u0442\u043E-\u0442\u043E
      \u0445\u0440\u0443\u0441\u0442\u0438\u0442\u2026 \u0421\u043A\u043E\u0440\u043B\u0443\u043F\u0430?"
    - "\u0421\u043A\u043E\u0440\u043B\u0443\u043F\u043A\u0430 \u043F\u043E\u043F\u0430\u043B\u0430\u0441\u044C.
      \u041D\u0430 \u0441\u0447\u0430\u0441\u0442\u044C\u0435, \u043D\u0430\u0432\u0435\u0440\u043D\u043E\u0435."
  - defect: "\u0431\u043B\u0435\u0434\u043D\u0430\u044F"
    lines:
    - "\u0411\u043B\u0435\u0434\u043D\u043E\u0432\u0430\u0442\u0430, \u043D\u043E
      \u0432\u043A\u0443\u0441\u043D\u043E."
    - "\u0415\u0439 \u0431\u044B \u0435\u0449\u0451 \u043F\u043E\u043B\u043C\u0438\u043D\u0443\u0442\u043A\u0438
      \u0432 \u0432\u0430\u0444\u0435\u043B\u044C\u043D\u0438\u0446\u0435."
  - defect: "\u043F\u0435\u0440\u0435\u0436\u0430\u0440\u0435\u043D\u0430"
    lines:
    - "\u0427\u0443\u0442\u044C \u043F\u0435\u0440\u0435\u0436\u0430\u0440\u0438\u043B\u0438."
    - "\u0417\u0430\u0436\u0430\u0440\u0438\u0441\u0442\u0430\u044F\u2026 \u043D\u0430
      \u043B\u044E\u0431\u0438\u0442\u0435\u043B\u044F."
  - defect: "\u043A\u043E\u043C\u043A\u0438"
    lines:
    - "\u041A\u043E\u043C\u043E\u0447\u043A\u0438 \u043F\u043E\u043F\u0430\u0434\u0430\u044E\u0442\u0441\u044F."
  - defect: "\u0442\u0435\u0441\u0442\u043E \u043F\u0435\u0440\u0435\u043C\u0435\u0448\u0430\u043D\u043E,
      \u0432\u0430\u0444\u043B\u044F \u0440\u0435\u0437\u0438\u043D\u043E\u0432\u0430\u044F"
    lines:
    - "\u0416\u0443\u0451\u0442\u0441\u044F \u0442\u0443\u0433\u043E\u0432\u0430\u0442\u043E."
  - defect: "\u043C\u043D\u043E\u0433\u043E \u0441\u0430\u0445\u0430\u0440\u0430"
    lines:
    - "\u0421\u043B\u0430\u0434\u043A\u043E\u0432\u0430\u0442\u043E \u0432\u044B\u0448\u043B\u043E."
  - defect: "\u043C\u0430\u043B\u043E \u0441\u0430\u0445\u0430\u0440\u0430"
    lines:
    - "\u0421\u0430\u0445\u0430\u0440\u0430 \u0431\u044B \u043F\u043E\u0431\u043E\u043B\u044C\u0448\u0435."
  - defect: "\u0433\u0443\u0441\u0442\u043E\u0435 \u0442\u0435\u0441\u0442\u043E"
    lines:
    - "\u0422\u044F\u0436\u0435\u043B\u043E\u0432\u0430\u0442\u0430 \u043F\u043E\u043B\u0443\u0447\u0438\u043B\u0430\u0441\u044C."
  - defect: "\u0436\u0438\u0434\u043A\u043E\u0435 \u0442\u0435\u0441\u0442\u043E"
    lines:
    - "\u0422\u043E\u043D\u043A\u043E\u0432\u0430\u0442\u0430, \u0440\u0430\u0441\u043F\u043E\u043B\u0437\u0430\u0435\u0442\u0441\u044F."
  - defect: "\u043C\u043D\u043E\u0433\u043E \u043C\u0443\u043A\u0438"
    lines:
    - "\u041C\u0443\u0447\u043D\u043E\u0439 \u043F\u0440\u0438\u0432\u043A\u0443\u0441
      \u0435\u0441\u0442\u044C."
  - defect: "\u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0430\u044F \u0432\u0430\u0444\u043B\u044F"
    lines:
    - "\u041C\u0430\u043B\u043E\u0432\u0430\u0442\u0430 \u0432\u0430\u0444\u043B\u044F."
  - defect: "\u0442\u0435\u0441\u0442\u043E \u0432\u044B\u0442\u0435\u043A\u043B\u043E"
    lines:
    - "\u041A\u0440\u0430\u044F \u043D\u0435\u0440\u043E\u0432\u043D\u044B\u0435
      \u2014 \u0442\u0435\u0441\u0442\u0430 \u043F\u0435\u0440\u0435\u043B\u0438\u043B\u0438?"
  - defect: "\u043F\u043E\u043B\u043E\u0436\u0438\u043B\u0438 \u0442\u043E, \u0447\u0442\u043E
      \u043D\u0435 \u043F\u0440\u043E\u0441\u0438\u043B\u0438"
    lines:
    - "\u0410 \u0432\u043E\u0442 \u044D\u0442\u043E \u0441\u0432\u0435\u0440\u0445\u0443
      \u2014 \u043B\u0438\u0448\u043D\u0435\u0435."
  perfectLines:
  - "\u041F\u0440\u0438\u0434\u0440\u0430\u0442\u044C\u0441\u044F \u043D\u0435 \u043A
    \u0447\u0435\u043C\u0443!"
  - "\u0412\u043E\u0442 \u044D\u0442\u043E \u044F \u043F\u043E\u043D\u0438\u043C\u0430\u044E
    \u2014 \u0432\u0430\u0444\u043B\u044F."
  waitedLines:
  - "\u0414\u043E\u043B\u0433\u043E\u0432\u0430\u0442\u043E \u0432\u044B\u0448\u043B\u043E."
  - "\u041F\u0440\u0438\u0448\u043B\u043E\u0441\u044C \u043F\u043E\u0434\u043E\u0436\u0434\u0430\u0442\u044C."
  outOfPatienceLines:
  - "\u041D\u0430\u043A\u043E\u043D\u0435\u0446-\u0442\u043E! \u0415\u0449\u0451
    \u043C\u0438\u043D\u0443\u0442\u0430 \u2014 \u0438 \u043C\u0435\u043D\u044F \u0431\u044B
    \u0442\u0443\u0442 \u043D\u0435 \u0431\u044B\u043B\u043E."
  - "\u041D\u0443 \u0438 \u043E\u0447\u0435\u0440\u0435\u0434\u044C \u0443 \u0432\u0430\u0441
    \u043D\u0430 \u043A\u0443\u0445\u043D\u0435\u2026"
